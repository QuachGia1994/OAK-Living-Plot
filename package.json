{
  "name": "living-plot",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run live:check:preview && npm run lint && npm run typecheck && npm run test",
    "live:check": "node scripts/check-live-readiness.mjs",
    "live:check:preview": "node scripts/check-live-readiness.mjs --allow-missing",
    "live:smoke:health": "node scripts/live-beta-smoke.mjs --mode=health",
    "live:smoke:core": "node scripts/live-beta-smoke.mjs --mode=core",
    "live:smoke:voice": "node scripts/live-beta-smoke.mjs --mode=voice",
    "live:smoke:billing": "node scripts/live-beta-smoke.mjs --mode=billing",
    "live:smoke:all": "node scripts/live-beta-smoke.mjs --mode=all",
    "retention:summary:dev": "node scripts/run-retention-summary.mjs"
  }
}
