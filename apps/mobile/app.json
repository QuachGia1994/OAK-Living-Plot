{
  "expo": {
    "name": "Living Plot",
    "slug": "living-plot",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "livingplot",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.oak.livingplot",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.oak.livingplot",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@clerk/expo"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
