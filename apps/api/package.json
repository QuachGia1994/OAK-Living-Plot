{
  "name": "@living-plot/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:remote": "wrangler dev --remote --env development",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:development": "wrangler d1 migrations apply DB --remote --env development",
    "eval:narrative": "vitest run test/narrative-evals.test.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "@cloudflare/workers-types": "5.20260816.1",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  },
  "dependencies": {
    "@clerk/backend": "3.16.6"
  }
}
